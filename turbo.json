{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["bun.lock", "mise.toml"],
  "globalPassThroughEnv": [
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_CLAUDE_CODE_VERSION",
    "ANTHROPIC_INSECURE"
  ],
  "tasks": {
    "check:all": {
      "dependsOn": ["types", "build", "test", "format:check", "lint"]
    },
    "types": {
      "dependsOn": ["build"]
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "format:check": {},
    "lint": {}
  },
  "ui": "tui"
}
